<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:VLOGusick.ViewModels"
             xmlns:models="clr-namespace:VLOGusick.Models"
             x:DataType="viewmodels:MainViewModel"
             x:Class="VLOGusick.MainPage"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="64,*,100">

        <!-- ===== ВЕРХНЯ ПАНЕЛЬ ===== -->
        <Grid Grid.Row="0"
              Padding="16,0"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="White">

            <!-- Кнопка VLOG — зверху зліва, синій колір #0075FF -->
            <Button Grid.Column="0"
                    Text="VLOG"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Secondary}"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource Secondary}"
                    BorderWidth="1.5"
                    CornerRadius="8"
                    Padding="12,6"
                    VerticalOptions="Center"
                    Command="{Binding ExportVlogCommand}" />

            <!-- Заголовок по центру -->
            <Label Grid.Column="1"
                   Text="Мій влог"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Лічильник кліпів справа -->
            <Label Grid.Column="2"
                   Text="{Binding Clips.Count, StringFormat='{0} кліпів'}"
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ===== СПИСОК КЛІПІВ ===== -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Clips}"
                        Margin="16,8">

            <!-- Відображається коли список порожній -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                    <Label Text="📽️"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Ще немає кліпів"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="Натисни + щоб записати перший кліп"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Шаблон одного кліпу -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ClipEntry">
                    <Border Margin="0,4"
                            Padding="14,12"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource Gray100}"
                            StrokeThickness="1">

                        <Grid ColumnDefinitions="48,*,48,48">

                            <!-- Іконка кліпу -->
                            <Label Grid.Column="0"
                                   Text="🎬"
                                   FontSize="24"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />

                            <!-- Час запису — натиск відкриває перегляд -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding RecordedAt}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Кнопка перегляду -->
                            <!-- ВАЖЛИВО: RelativeSource потрібен бо всередині CollectionView
                                 BindingContext = ClipEntry, а не MainViewModel.
                                 Щоб дістатись до команди ViewModel — підіймаємось по дереву до ContentPage -->
                            <Button Grid.Column="2"
                                    Text="▶"
                                    FontSize="16"
                                    TextColor="{StaticResource Secondary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenPreviewCommand}"
                                    CommandParameter="{Binding .}" />

                            <!-- Кнопка видалення -->
                            <Button Grid.Column="3"
                                    Text="✕"
                                    FontSize="16"
                                    TextColor="#FF4444"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteClipCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ===== НИЖНЯ ПАНЕЛЬ З КНОПКОЮ «+» ===== -->
        <Grid Grid.Row="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">

            <!-- Індикатор запису — видимий тільки під час запису -->
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="6"
                                 IsVisible="{Binding IsRecording}">
                <ActivityIndicator IsRunning="{Binding IsRecording}"
                                   Color="{StaticResource Secondary}"
                                   HorizontalOptions="Center" />
                <Label Text="Запис 2 сек..."
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Кнопка «+» з градієнтом #FFA1F9 → #0075FF -->
            <Button Text="+"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="White"
                    WidthRequest="72"
                    HeightRequest="72"
                    CornerRadius="36"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsRecording, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding RecordClipCommand}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFA1F9" Offset="0.0" />
                        <GradientStop Color="#0075FF" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

        </Grid>

    </Grid>

</ContentPage>
